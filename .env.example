# Export these variables in the shell; scripts do not automatically load .env.
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Hugging Face model IDs or local model directories.
FINMRAG_EMBED_MODEL=vidore/colqwen2-v1.0
FINMRAG_RERANK_MODEL=jinaai/jina-reranker-m0

# Opt in to token-count-only usage logs under results/api_use/.
FINMRAG_LOG_USAGE=0
